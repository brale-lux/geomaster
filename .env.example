# Copy to .env (never commit .env). Only the import tool and CI use these; the app never
# receives the service role key or the database password.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
# Direct Postgres connection used by `tool/import_questions.py import` (server-side only).
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
